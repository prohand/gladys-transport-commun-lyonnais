        "es": "10063, Hotel de Ville:Trabajo"
      }
    },
    {
      "key": "park_and_ride",
      "type": "string",
      "label": {
        "en": "Park & ride (P+R)",
        "fr": "Parcs relais (P+R)",
        "de": "P+R-Parkplätze (Park & Ride)",
        "es": "Aparcamientos disuasorios (P+R)"
      },
      "description": {
        "en": "Park & ride identifiers or names, with an optional custom name after : — e.g. \"Gorge de Loup, Parilly:Commute\".",
        "fr": "Identifiants ou noms de parcs relais, avec un nom personnalisé optionnel après : — ex. « Gorge de Loup, Parilly:Trajet boulot ».",
        "de": "Kennungen oder Namen der P+R-Parkplätze, mit optionalem eigenem Namen nach : — z. B. „Gorge de Loup, Parilly:Pendeln“.",
        "es": "Identificadores o nombres de aparcamientos disuasorios, con un nombre personalizado opcional tras : — p. ej. «Gorge de Loup, Parilly:Trabajo»."
      },
      "required": false,
      "placeholder": {
        "en": "Gorge de Loup, Parilly:Commute",
        "fr": "Gorge de Loup, Parilly:Trajet boulot",
        "de": "Gorge de Loup, Parilly:Pendeln",
        "es": "Gorge de Loup, Parilly:Trabajo"
      }
    },
    {
      "key": "refresh",
      "type": "section",
      "label": {
        "en": "Refresh intervals",
        "fr": "Fréquences de rafraîchissement",
        "de": "Aktualisierungsintervalle",
        "es": "Intervalos de actualización"
      },
      "description": {
        "en": "Each device is refreshed by Gladys at its own interval. The upstream feeds are recomputed about once a minute, so polling faster only costs requests.",
        "fr": "Chaque appareil est rafraîchi par Gladys à son propre intervalle. Les flux sources sont recalculés environ toutes les minutes : interroger plus souvent ne fait que consommer des requêtes.",
        "de": "Gladys aktualisiert jedes Gerät in seinem eigenen Intervall. Die Quell-Feeds werden etwa einmal pro Minute neu berechnet: Häufigeres Abfragen kostet nur Anfragen.",
        "es": "Gladys actualiza cada dispositivo con su propio intervalo. Los feeds de origen se recalculan aproximadamente una vez por minuto, así que consultar más a menudo solo consume peticiones."
      }
    },
    {
      "key": "departures_poll_frequency",
      "type": "number",
      "label": {
        "en": "Departures refresh interval (s)",
        "fr": "Rafraîchissement des passages (s)",
        "de": "Aktualisierung der Abfahrten (s)",
        "es": "Actualización de salidas (s)"
      },
      "description": {
        "en": "How often the next departures of each watched stop are refreshed, in seconds.",
        "fr": "Fréquence de rafraîchissement des prochains passages de chaque arrêt surveillé, en secondes.",
        "de": "Wie oft die nächsten Abfahrten jeder überwachten Haltestelle aktualisiert werden, in Sekunden.",
        "es": "Frecuencia de actualización de las próximas salidas de cada parada vigilada, en segundos."
      },
      "required": false,
      "default": 60,
      "min": 30,
      "max": 3600
    },
    {
      "key": "velov_poll_frequency",
      "type": "number",
      "label": {
        "en": "Vélo'v refresh interval (s)",
        "fr": "Rafraîchissement Vélo'v (s)",
        "de": "Aktualisierung Vélo'v (s)",
        "es": "Actualización de Vélo'v (s)"
      },
      "description": {
        "en": "How often bike and dock availability is refreshed, in seconds.",
        "fr": "Fréquence de rafraîchissement des vélos et places disponibles, en secondes.",
        "de": "Wie oft die Verfügbarkeit von Rädern und Stellplätzen aktualisiert wird, in Sekunden.",
        "es": "Frecuencia de actualización de la disponibilidad de bicis y anclajes, en segundos."
      },
      "required": false,
      "default": 120,
      "min": 30,
      "max": 3600
    },
    {
      "key": "park_and_ride_poll_frequency",
      "type": "number",
      "label": {
        "en": "Park & ride refresh interval (s)",
        "fr": "Rafraîchissement parcs relais (s)",
        "de": "Aktualisierung P+R-Parkplätze (s)",
        "es": "Actualización de aparcamientos (s)"
      },
      "description": {
        "en": "How often park & ride occupancy is refreshed, in seconds.",
        "fr": "Fréquence de rafraîchissement de l'occupation des parcs relais, en secondes.",
        "de": "Wie oft die Belegung der P+R-Parkplätze aktualisiert wird, in Sekunden.",
        "es": "Frecuencia de actualización de la ocupación de los aparcamientos disuasorios, en segundos."
      },
      "required": false,
      "default": 300,
      "min": 30,
      "max": 3600
    },
    {
      "key": "max_departures",
      "type": "number",
      "label": {
        "en": "Departures per stop",
        "fr": "Passages par arrêt",
        "de": "Abfahrten pro Haltestelle",
        "es": "Salidas por parada"
      },
      "description": {
        "en": "How many upcoming departures each stop device exposes as features.",
        "fr": "Nombre de prochains passages exposés en fonctionnalités par arrêt.",
        "de": "Wie viele kommende Abfahrten jedes Haltestellen-Gerät als Funktionen bereitstellt.",
        "es": "Número de próximas salidas que cada dispositivo de parada expone como funciones."
      },
      "required": false,
      "default": 3,
      "min": 1,
      "max": 5
    }
  ],
  "actions": [
